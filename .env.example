APP_NAME="BD ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.example.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,security
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production database: MySQL 8.x (architecture decision D2 — one database per ERP instance).
# For local development SQLite works out of the box (DB_CONNECTION=sqlite below).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_erp
DB_USERNAME=erp
DB_PASSWORD=
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true when serving over HTTPS:
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# BD ERP foundation knobs (all optional — DB settings override at runtime)
ERP_SETUP_TOKEN_TTL=60
ERP_PASSWORD_MIN_LENGTH=10
ERP_LOCKOUT_MAX_ATTEMPTS=5
ERP_LOCKOUT_MINUTES=15
ERP_SESSION_IDLE_MINUTES=30
ERP_SESSION_MAX_CONCURRENT=3
ERP_HSTS=true
ERP_NOTIFICATION_POLL=60
ERP_OUTBOX_MAX_ATTEMPTS=5
